{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bobmcmxciv/local-ai-bench/schema/benchmark-result.schema.json",
  "title": "Local AI Hardware & Optimization Tier Benchmark Result",
  "description": "Standardized output format for ASR (SenseVoice Small) and Local LLM (0.6B-9B) cross-device, multi-tier hardware acceleration benchmarks.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "device",
    "asr_benchmarks",
    "llm_benchmarks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "device": {
      "type": "object",
      "required": ["id", "name", "soc_or_cpu", "os", "ram_gb", "compute_units"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "name": { "type": "string" },
        "form_factor": { "type": "string", "enum": ["desktop", "laptop", "tablet", "phone", "mini_pc", "server"] },
        "soc_or_cpu": { "type": "string" },
        "cpu_cores_threads": { "type": "string" },
        "cpu_isa_flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gpu_model": { "type": ["string", "null"] },
        "gpu_vram_gb": { "type": ["number", "null"] },
        "npu_model": { "type": ["string", "null"] },
        "ram_gb": { "type": "number" },
        "ram_type": { "type": "string" },
        "os": { "type": "string" },
        "compute_units": {
          "type": "array",
          "items": { "type": "string", "enum": ["CPU", "GPU", "NPU"] }
        }
      }
    },
    "asr_benchmarks": {
      "type": "array",
      "description": "SenseVoice Small speech-to-text benchmarks across optimization tiers (CPU scalar/baseline -> CPU SIMD/INT8 -> CPU Matrix AMX/SME2/AVX-512 -> GPU -> NPU).",
      "items": {
        "type": "object",
        "required": ["unit", "tier", "route_label", "runtime", "precision", "status"],
        "properties": {
          "unit": { "type": "string", "enum": ["CPU", "GPU", "NPU", "AUTO"] },
          "tier": {
            "type": "string",
            "enum": [
              "T1_CPU_BASELINE",
              "T2_CPU_SIMD_INT8_FP16",
              "T2_CPU_VECTOR_INT8",
              "T3_CPU_MATRIX_ISA",
              "T4_GPU_ACCELERATED",
              "T5_NPU_DEDICATED"
            ]
          },
          "route_label": { "type": "string" },
          "runtime": { "type": "string" },
          "precision": { "type": "string", "enum": ["FP32", "FP16", "BF16", "INT8", "MIXED"] },
          "threads": { "type": ["integer", "null"] },
          "streams_or_processes": { "type": ["integer", "null"] },
          "status": { "type": "string", "enum": ["ok", "timeout", "oom_skipped", "skipped-memory-guard", "unsupported", "failed"] },
          "window_10s_ms": { "type": ["number", "null"], "description": "Median single 10s window inference latency in ms (167 LFR frames = 3.504 GFLOPs)." },
          "call_378s_s": { "type": ["number", "null"], "description": "End-to-end processing time in seconds for the 378.3s (6.3 min) call audio." },
          "meeting_2957s_s": { "type": ["number", "null"], "description": "End-to-end processing time in seconds for the 2956.9s (49.3 min) meeting audio." },
          "realtime_factor_x": { "type": ["number", "null"], "description": "2956.9 / meeting_2957s_s (or 378.3 / call_378s_s)." },
          "effective_tflops": { "type": ["number", "null"], "description": "3.504 / window_10s_ms (since 3.504 GFLOPs / (ms * 1e-3) = 3.504 / ms TFLOPS)." },
          "peak_tflops_ref": { "type": ["number", "null"] },
          "hardware_utilization_pct": { "type": ["number", "null"] },
          "power_scope": { "type": ["string", "null"], "enum": ["whole_device_battery", "module_rails_rapl_pm", "gpu_board_nvml", "process_cpu_counter", null] },
          "avg_delta_power_w": { "type": ["number", "null"] },
          "total_energy_j": { "type": ["number", "null"] },
          "cer_pct": { "type": ["number", "null"] },
          "notes": { "type": "string" }
        }
      }
    },
    "llm_benchmarks": {
      "type": "array",
      "description": "Local LLM benchmarks across models (0.6B to 9B) and hardware/ISA optimization tiers, including memory/VRAM boundary tracking.",
      "items": {
        "type": "object",
        "required": ["model", "quantization", "unit", "tier", "route_label", "status"],
        "properties": {
          "model": { "type": "string" },
          "params_b": { "type": "number" },
          "quantization": { "type": "string" },
          "model_size_gb": { "type": "number" },
          "unit": { "type": "string", "enum": ["CPU", "GPU", "NPU"] },
          "tier": {
            "type": "string",
            "enum": [
              "T1_CPU_BASELINE",
              "T2_CPU_SIMD_INT8_FP16",
              "T2_CPU_VECTOR_INT8",
              "T3_CPU_MATRIX_ISA",
              "T4_GPU_ACCELERATED",
              "T5_NPU_DEDICATED"
            ]
          },
          "route_label": { "type": "string" },
          "isa_or_backend": { "type": "string" },
          "threads": { "type": ["integer", "null"] },
          "status": { "type": "string", "enum": ["ok", "vram_overflow_degraded", "oom_guarded", "skipped-memory-guard", "timeout", "unsupported"] },
          "load_s": { "type": ["number", "null"] },
          "prompt_tokens": { "type": ["integer", "null"] },
          "gen_tokens": { "type": ["integer", "null"] },
          "ttft_ms": { "type": ["number", "null"] },
          "prefill_tps": { "type": ["number", "null"] },
          "decode_tps": { "type": ["number", "null"] },
          "pp128_tps": { "type": ["number", "null"] },
          "pp1000_tps": { "type": ["number", "null"] },
          "tg32_tps": { "type": ["number", "null"] },
          "tg128_tps": { "type": ["number", "null"] },
          "mem_avail_before_gb": { "type": ["number", "null"] },
          "mem_avail_after_gb": { "type": ["number", "null"] },
          "vram_used_gb": { "type": ["number", "null"] },
          "vram_total_gb": { "type": ["number", "null"] },
          "overflow_detected": { "type": "boolean" },
          "power_scope": { "type": ["string", "null"] },
          "decode_delta_power_w": { "type": ["number", "null"] },
          "decode_energy_j_per_tok": { "type": ["number", "null"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
